import {
  "mizchi/luna/js/resource",
  "mizchi/luna/core/routes",
  "mizchi/luna/dom/router",
  "mizchi/luna/dom" @element,
  "mizchi/js_browser/dom",
  "mizchi/js_core" @js,
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: { "js": { "exports": [ "hydrate" ], "format": "esm" } },
)
