import {
  "mizchi/luna/js/resource",
  "mizchi/signals",
  "mizchi/luna",
  "mizchi/luna/js/api" @luna_api,
  "mizchi/js/core" @js,
  "mizchi/js_browser/dom" @js_dom,
  "mizchi/js/builtins/global",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: { "js": { "format": "esm" } },
)
