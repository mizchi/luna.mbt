        "quart_out:quartOut",
        "quart_in_out:quartInOut",
        "quint_in:quintIn",
        "quint_out:quintOut",
        "quint_in_out:quintInOut",
        "sine_in:sineIn",
        "sine_out:sineOut",
        "sine_in_out:sineInOut",
        "circ_in:circIn",
        "circ_out:circOut",
        "circ_in_out:circInOut",
        "expo_in:expoIn",
        "expo_out:expoOut",
        "expo_in_out:expoInOut",
        "back_in:backIn",
        "back_out:backOut",
        "back_in_out:backInOut",
        "elastic_in:elasticIn",
