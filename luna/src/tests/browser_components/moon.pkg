import {
  "mizchi/luna",
  "mizchi/signals",
  "mizchi/luna/js/resource",
  "mizchi/js_browser/dom" @js_dom,
  "mizchi/luna/dom",
  "mizchi/luna/dom/client",
  "mizchi/js/core" @js,
}

supported_targets = "js"

options(
  link: {
    "js": {
      "exports": [
        "hydrate_signal_effect",
        "hydrate_dynamic_attrs",
        "hydrate_show_toggle",
        "hydrate_for_each",
        "hydrate_events",
        "hydrate_sortable_list",
        "hydrate_input_binding",
        "hydrate_element_ref",
      ],
      "format": "esm",
    },
  },
)
