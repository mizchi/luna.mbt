name = "mizchi/luna"

version = "0.23.2"

import {
  "moonbitlang/async@0.21.2",
  "moonbitlang/x@0.5.1",
  "mizchi/js@0.12.2",
  "mizchi/js_browser@0.12.2",
  "mizchi/npm_typed@0.1.15",
  "moonbitlang/parser@0.3.18",
  "mizchi/signals@0.6.5",
  "mizchi/x@0.5.3",
  "moonbitlang/lexer@0.3.15",
}

readme = "README.md"

repository = "https://github.com/mizchi/luna.mbt"

license = "MIT"

keywords = [ "luna", "ui", "signals" ]

description = "Fine-grained reactive UI library for Moonbit/JS"

source = "src"

warnings = "-6-unused_trait_bound"

preferred_target = "js"
