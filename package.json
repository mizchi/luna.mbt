{
  "name": "luna.mbt",
  "private": true,
  "type": "module",
  "description": "MoonBit Island Architecture UI Framework",
  "scripts": {
    "build:moon": "node scripts/check-moon-toolchain.mjs && moon build --target js --release",
    "build:loader": "pnpm --filter @luna_ui/luna-loader build",
    "test:moonbit": "moon test --target js",
    "test:integration": "node --test tests/integration/*.test.js astra/e2e/build_dev_parity.test.js",
    "test:node": "pnpm vitest run --config luna/vitest.config.ts --project node",
    "test:browser": "pnpm vitest run --config luna/vitest.config.ts --project browser",
    "test:bench": "pnpm vitest bench --config luna/vitest.config.ts --project bench",
    "test:vitest": "pnpm vitest run --config luna/vitest.config.ts --project node --project browser",
    "test:e2e": "env -u NO_COLOR pnpm playwright test --config luna/e2e/playwright.config.mts",
    "dev": "pnpm vite --config luna/vite.config.ts",
    "build:npm": "pnpm build:moon && pnpm --filter './js/*' --filter '!@luna_ui/wcssr' -r build",
    "test:npm-pack": "node --test tests/integration/moon-toolchain.test.js tests/integration/npm-workspace.test.js tests/integration/npm-cli-pack.test.js"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@preact/signals": "^2.11.2",
    "@preact/signals-core": "^1.14.4",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.13.0",
    "colorette": "^2.0.20",
    "esbuild": "^0.28.2",
    "execa": "^10.0.1",
    "happy-dom": "^20.14.3",
    "hono": "^4.13.7",
    "jsdom": "^30.0.1",
    "memfs": "^4.72.2",
    "monocart-coverage-reports": "^2.13.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.63.0",
    "preact": "^10.29.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rolldown": "1.2.8",
    "source-map": "^0.8.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vite-plugin-moonbit": "^0.5.1",
    "vitest": "^5.0.0",
    "global-jsdom": "^30.0.0"
  },
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b",
  "engines": {
    "node": ">=24.15.0"
  }
}
