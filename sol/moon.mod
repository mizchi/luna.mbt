  "mizchi/astra@0.23.2",
  "mizchi/luna@0.23.2",
  "moonbitlang/async@0.20.1",
  "moonbitlang/x@0.4.50",
  "moonbitlang/parser@0.3.8",
  "mizchi/npm_typed@0.1.15",
  "mizchi/js@0.12.1",
  "mizchi/js_browser@0.12.1",
  "mizchi/mars@0.3.10",
  "mizchi/ts@0.3.0",
