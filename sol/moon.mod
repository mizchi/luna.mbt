import {
  "moonbitlang/yacc@0.7.19",
  "mizchi/astra@0.23.2",
  "mizchi/luna@0.23.3",
  "moonbitlang/async@0.21.2",
  "moonbitlang/x@0.5.1",
  "moonbitlang/parser@0.3.18",
  "mizchi/npm_typed@0.1.15",
  "mizchi/js@0.12.2",
  "mizchi/js_browser@0.12.2",
  "mizchi/mars@0.3.11",
