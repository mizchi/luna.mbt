{
  "name": "sol-auth-example",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../../scripts/run-cli.mjs sol dev",
    "dev:auth": "tsx dev-auth.ts",
    "dev:wrangler": "wrangler dev",
    "build": "node ../../../scripts/run-cli.mjs sol build",
    "serve": "node ../../../scripts/run-cli.mjs sol serve",
    "test": "playwright test",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create sol-auth-db",
    "db:migrate": "wrangler d1 execute sol-auth-db --file=migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 execute sol-auth-db --local --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-auth": "^1.7.11",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "tsx": "^4.23.15",
    "wrangler": "^4.151.2"
  },
  "private": true
}
