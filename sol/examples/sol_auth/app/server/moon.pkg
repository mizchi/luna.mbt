supported_targets = "js"

import {
  "mizchi/luna",
  "mizchi/sol",
  "mizchi/sol/middleware" @mw,
  "mizchi/sol/action",
  "mizchi/sol_adapter_cloudflare" @sol_cloudflare,
  "mizchi/luna/dom/static" @server_dom,
  "mizchi/js/core",
  "example/sol-auth/layout",
  "example/sol-auth/__gen__/types",
  "example/sol-auth/client",
  "moonbitlang/core/json",
  "moonbitlang/async",
}

warnings = "-35-67-24-29"

pkgtype(kind: "executable")

options(
  link: { "js": { "format": "esm" } },
)
