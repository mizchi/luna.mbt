  "mizchi/astra",
  "mizchi/astra/routes" @sol_routes,
  "mizchi/luna/dom/static" @server_dom,
  "mizchi/sol/middleware",
  "mizchi/sol/isr",
  "mizchi/mars",
  "mizchi/js/core" @js,
  "mizchi/js/web/http" @web_http,
