// Sol CLI install entry point — installable via
// `moon install mizchi/sol/cmd/sol` ($MOON_HOME/bin/sol).
// Keep this native-compatible because `moon install` builds native binaries.

import {
  "mizchi/x/fs",
  "mizchi/x/sys",
  "mizchi/x/process",
  "mizchi/sol/scaffold_templates",
  "mizchi/sol/version",
  "moonbitlang/core/env",
  "moonbitlang/async",
}

supported_targets = "native"

pkgtype(kind: "executable")
