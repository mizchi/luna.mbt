# MoonBit coverage
coverage:
    rm -f _build/moonbit_coverage_*.txt
    moon test --target js --enable-coverage
    moon coverage report -f summary

# Coverage clean
coverage-clean:
    rm -rf coverage/
    moon coverage clean

