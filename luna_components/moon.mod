name = "mizchi/luna_components"

version = "0.23.1"

import {
  "mizchi/luna@0.23.1",
  "mizchi/signals@0.6.4",
  "mizchi/js@0.12.1",
  "mizchi/js_browser@0.12.1",
}

readme = "README.md"

repository = "https://github.com/mizchi/luna.mbt"

license = "MIT"

keywords = [ "luna", "components", "apg", "headless", "ui" ]

description = "Headless + styled UI components (WAI-ARIA APG patterns) for Luna UI"

source = "src"

warnings = "-6-unused_trait_bound"

preferred_target = "js"
