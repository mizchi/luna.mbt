import {
  "mizchi/luna_components/styled",
  "mizchi/luna_components/styled/switch",
  "mizchi/luna_components/styled/checkbox",
  "mizchi/luna_components/styled/tabs",
  "mizchi/luna_components/styled/accordion",
}

supported_targets = "js"

options(
  link: {
    "js": {
      "exports": [
        "get_theme_variables:getThemeVariables",
        "get_switch_css:getSwitchCss",
        "get_checkbox_css:getCheckboxCss",
        "get_tabs_css:getTabsCss",
        "get_accordion_css:getAccordionCss",
        "get_all_css:getAllCss",
      ],
      "format": "esm",
    },
  },
)
