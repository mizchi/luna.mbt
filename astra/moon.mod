name = "mizchi/astra"

version = "0.23.0"

import {
  "mizchi/luna@0.23.0",
  "mizchi/mars@0.3.10",
  "mizchi/markdown@0.6.2",
  "mizchi/js@0.12.1",
  "mizchi/npm_typed@0.1.15",
  "mizchi/process_pool@0.1.3",
  "mizchi/syntree@0.2.3",
  "mizchi/x@0.3.0",
  "moonbitlang/async@0.20.1",
  "moonbitlang/x@0.4.46",
}

readme = "README.md"

repository = "https://github.com/mizchi/luna.mbt"

license = "MIT"

keywords = [ "astra", "ssg", "mars", "moonbit", "middleware" ]

description = "Mountable Mars middleware for static site generation"

source = "src"

preferred_target = "js"
