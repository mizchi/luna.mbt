name = "mizchi/astra"

version = "0.23.2"

import {
  "mizchi/luna@0.23.2",
  "mizchi/mars@0.3.11",
  "mizchi/markdown@0.7.4",
  "mizchi/js@0.12.2",
  "mizchi/npm_typed@0.1.15",
  "mizchi/process_pool@0.1.3",
  "mizchi/syntree@0.2.4",
  "mizchi/x@0.5.3",
  "moonbitlang/async@0.21.2",
  "moonbitlang/x@0.5.1",
}

readme = "README.md"

