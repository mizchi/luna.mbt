{
  "name": "@luna_ui/stella",
  "version": "0.22.0",
  "description": "Stella CLI - Web Components generator for Luna",
  "type": "module",
  "bin": {
    "stella": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@luna_ui/wcr": "^0.22.0"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "web-components",
    "cli",
    "luna",
    "moonbit"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/luna.mbt.git",
    "directory": "js/stella"
  },
  "publishConfig": {
    "access": "public"
  }
}
