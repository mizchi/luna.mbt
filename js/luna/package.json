{
  "name": "@luna_ui/luna",
  "version": "0.23.2",
  "description": "Fine-grained reactive UI library for Moonbit/JS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "@luna_ui/luna": "./dist/cli.mjs",
    "luna": "./dist/cli.mjs"
  },
  "exports": {
    "./void": {
      "types": "./dist/void.d.ts",
      "import": "./dist/void.js"
    },
    "./void/server": {
      "types": "./dist/void/server.d.ts",
      "import": "./dist/void/server.js"
    },
    "./void/client": {
      "types": "./dist/void/client.d.ts",
      "import": "./dist/void/client.js"
    },
    "./animation": {
      "types": "./dist/animation.d.ts",
      "import": "./dist/animation.js"
    },
    "./easing": {
      "types": "./dist/easing.d.ts",
      "import": "./dist/easing.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./signals": {
      "types": "./dist/signals.d.ts",
      "import": "./dist/signals.js"
    },
    "./signals-shared": {
      "types": "./dist/signals-shared.d.ts",
      "import": "./dist/signals-shared.js"
    },
    "./resource": {
      "types": "./dist/resource.d.ts",
      "import": "./dist/resource.js"
    },
    "./router-lite": {
      "types": "./dist/router-lite.d.ts",
      "import": "./dist/router-lite.js"
    },
    "./raw": {
      "types": "./dist/raw.d.ts",
      "import": "./dist/raw.js"
    },
    "./css": {
      "types": "./dist/css/index.d.ts",
      "import": "./dist/css/index.js"
    },
    "./css/runtime": {
      "types": "./dist/css/runtime.d.ts",
      "import": "./dist/css/runtime.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    },
    "./event-utils": {
      "types": "./dist/event-utils.d.ts",
      "import": "./dist/event-utils.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    }
  },
  "scripts": {
    "build:moon": "node scripts/build-moon.mjs",
    "build": "node ../../luna/scripts/strip-moonbit-abort-loc.mjs && tsdown",
    "test": "vitest run --root ../..",
    "test:void": "vitest run --config void.vitest.config.ts",
    "build:examples": "vite build examples",
    "prepack": "pnpm build:moon && pnpm build"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "preact": "^10.29.8",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "void": "1.1.11",
    "wrangler": "4.151.1"
  },
  "peerDependencies": {
    "vite": "^8.3.0",
    "void": "1.1.11"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "void": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/luna.mbt.git",
    "directory": "js/luna"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "files": [
    "dist",
    "docs/void.md"
  ]
}
